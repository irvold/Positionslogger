[Unit]
Description=Positionslogger server
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/positionslogger
EnvironmentFile=/etc/positionslogger.env
ExecStart=/home/pi/positionslogger/.venv/bin/python -m uvicorn app:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3

# lidt hærdning
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
