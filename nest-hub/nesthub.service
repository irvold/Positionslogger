[Unit]
Description=Positionslogger på Google Nest Hub (kiosk + oplæsning)
After=network-online.target positionslogger.service
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/positionslogger/nest-hub
ExecStart=/home/pi/positionslogger/nest-hub/.venv/bin/python nesthub.py --config config.toml
Restart=always
RestartSec=10

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
